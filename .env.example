# Copy to .env.local and fill in. Never commit real keys.

# Finnhub key for the FX feed (browser-exposed; use a restricted key).
NEXT_PUBLIC_FINNHUB_API_KEY=

# Orderflow snapshot export: while the dashboard is open it writes a
# BTCUSDT all-perps summary (schema orderflow-snapshot/v1) to
# <ORDERFLOW_EXPORT_DIR>/BTCUSDT.json every interval, replaced atomically.
# Default folder: Z:\Daily brief\orderflow. Set the flag to 0 to turn it off.
ORDERFLOW_EXPORT_DIR=
NEXT_PUBLIC_ORDERFLOW_EXPORT=1
NEXT_PUBLIC_ORDERFLOW_EXPORT_INTERVAL_MS=60000

# Public URL of the deployment, used for canonical links and absolute
# Open Graph / Twitter image URLs. Optional on Vercel (detected automatically).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
